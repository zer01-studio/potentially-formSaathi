{
  "manifest_version": 3,
  "name": "FormSaathi Autofill",
  "version": "0.1.0",
  "description": "Match saved FormSaathi answers to the page you're on, review every value, then fill the fields.",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FormSaathi Autofill"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
